# Copy to .env.local for local dev overrides (Vite convention).
# URL of the standalone Mock SSC portal — a genuinely separate website,
# not part of this app. Used only for a "Try it" link on the dashboard;
# OTR never embeds or iframes this site.
VITE_SSC_PORTAL_URL=http://localhost:5174

# Base URL of OTR's own backend API. Leave EMPTY/unset for local dev —
# the Vite dev server proxies relative /api/... calls to localhost:4000
# (see vite.config.ts). In production (e.g. deployed as a static site on
# Vercel/Netlify), there is no dev proxy, so this MUST be set to the
# deployed backend's origin, e.g.:
# VITE_OTR_API_URL=https://otr-india-backend.onrender.com
VITE_OTR_API_URL=
