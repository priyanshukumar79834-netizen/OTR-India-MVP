# Copy this file to .env and fill in real local values.
# NEVER commit .env — see MASTER_SPECIFICATION.md §17 and TEAM_WORKFLOW.md §14.

# --- Server ---
PORT=4000
NODE_ENV=development

# --- Database (PostgreSQL) ---
# Local dev example — replace credentials for your own machine:
DATABASE_URL="postgresql://otr_dev:CHANGE_ME@localhost:5432/otr_india_dev"

# Set to "true" only if your local Postgres requires SSL (uncommon).
# In production this defaults to true automatically when NODE_ENV=production,
# so you normally don't need to set it there either — only override if your
# hosted provider's connection string is unusual. See src/config/env.ts.
# DATABASE_SSL=true

# --- Auth (demo/OTP-simulation boundary — see MASTER_SPECIFICATION.md §15) ---
# Generate your own local secret; never reuse this value anywhere real.
JWT_SECRET="CHANGE_ME_LOCAL_DEV_ONLY"
JWT_EXPIRES_IN="1d"

# --- CORS ---
# Comma-separated. Must include BOTH standalone frontends: OTR's own
# citizen portal AND the separate Mock SSC portal (which calls this
# backend directly, cross-origin — see docs/ARCHITECTURE_DECISIONS.md).
CORS_ORIGIN="http://localhost:5173,http://localhost:5174"
