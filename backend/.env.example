# Copy this file to .env and fill in real local values.
# NEVER commit .env — see MASTER_SPECIFICATION.md §17 and TEAM_WORKFLOW.md §14.

# --- Server ---
PORT=4000
NODE_ENV=development

# --- Database (PostgreSQL) ---
# Local dev example — replace credentials for your own machine:
DATABASE_URL="postgresql://otr_dev:CHANGE_ME@localhost:5432/otr_india_dev"

# --- Auth (demo/OTP-simulation boundary — see MASTER_SPECIFICATION.md §15) ---
# Generate your own local secret; never reuse this value anywhere real.
JWT_SECRET="CHANGE_ME_LOCAL_DEV_ONLY"
JWT_EXPIRES_IN="1d"

# --- CORS ---
CORS_ORIGIN="http://localhost:5173"
