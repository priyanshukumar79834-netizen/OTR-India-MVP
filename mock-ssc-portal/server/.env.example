# mock-ssc-portal/server — the SSC bridge server's own environment.
# NEVER commit the real .env. This process is the only place the SSC
# client secret is allowed to exist.

PORT=4174

# Where OTR-India's backend is running.
OTR_API_URL=http://localhost:4000

# This client's identity. Must match a clientId seeded in
# backend/src/modules/government-clients/governmentClients.service.ts.
SSC_OTR_CLIENT_ID=SSC_EXAM_PORTAL

# The plaintext secret for the above client. On a fresh OTR backend, this
# is generated once and printed to the OTR backend's own startup logs
# (search for "Seeded government client SSC_EXAM_PORTAL" or "Backfilled
# client secret") — copy it here. If OTR's backend is started with
# SSC_OTR_CLIENT_SECRET already set in ITS OWN env, that exact value is
# what must go here instead (see governmentClients.service.ts's
# secretEnvVar handling).
SSC_OTR_CLIENT_SECRET=

# Must be an EXACT match for one of this client's registered
# redirectUris on the OTR backend.
SSC_REDIRECT_URI=http://localhost:5174/callback

# Only this origin may call this bridge's /api/ssc/* routes.
SSC_APP_ORIGIN=http://localhost:5174
