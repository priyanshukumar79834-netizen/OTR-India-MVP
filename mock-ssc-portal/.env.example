# Copy to .env.local for local dev overrides (Vite convention).

# OTR-India's backend — this app calls it DIRECTLY, cross-origin, exactly
# like a real external government portal would (no proxy, no shared
# server). Must be included in OTR backend's CORS_ORIGIN allow-list.
VITE_OTR_API_URL=http://localhost:4000

# OTR-India's own citizen-facing website — used only to build the
# "Continue with OTR" redirect link. This app never embeds or iframes it.
VITE_OTR_APP_URL=http://localhost:5173
